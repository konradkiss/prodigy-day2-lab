{
  "name": "prodigy-day2-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A small order service in C#: the guardrails lab, stage by stage",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "dotnet run --project src/Orders",
    "test": "dotnet test",
    "stryker": "dotnet tool restore && dotnet stryker",
    "doctor": "node scripts/doctor.mjs",
    "stages": "node scripts/lab.mjs stages",
    "stage": "node scripts/lab.mjs stage",
    "referee": "node scripts/lab.mjs referee",
    "mutate": "node scripts/lab.mjs mutate",
    "restore": "node scripts/lab.mjs restore",
    "wire-rules": "node scripts/lab.mjs wire-rules",
    "lock-rules": "node scripts/lab.mjs lock-rules"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3"
  }
}
